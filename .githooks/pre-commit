#!/bin/sh
# Keep marketplace.json's plugin version matching plugin.json before every commit.
set -e

root=$(git rev-parse --show-toplevel)

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found, skipping version sync" >&2
  exit 0
fi

if python3 "$root/scripts/sync-version.py" | grep -q .; then
  git add "$root/.claude-plugin/marketplace.json"
fi
